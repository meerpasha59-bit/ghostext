{
  "enabled": true,
  "name": "Run tests on save",
  "description": "Whenever a source or test file is saved, run the node:test suite and fix any failure before continuing.",
  "version": "1",
  "when": { "type": "fileEdited", "patterns": ["src/**/*.js", "test/**/*.js"] },
  "then": { "type": "askAgent", "prompt": "A Ghostext source file changed. Run `node --test`. If anything fails, fix the code (not the test) unless the test contradicts the spec in .kiro/specs/ghostext-core. Report pass/fail counts." }
}
